<mxfile host="app.diagrams.net"><diagram name="① 전체 구조" id="p94793695"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v2" value="&lt;b&gt;기억을 맞추는 테트리스 — 전체 구조 (tetris/core 폴더 = 묶음)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;의존은 위 → 아래 한 방향. Windows API는 ui/ 의 Windows* 클래스에만 있다. 세부는 ② 상속, ③ 포함, ④ 상세 탭 참고&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1200" height="60" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b style=&quot;font-size:14px&quot;&gt;flow/ — 게임 루프와 장면&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;Game · SceneManager · Scene · TitleScene · NarrativeScene · PrologueScene · EndingScene · PlayScene · AlbumScene · GameOverScene · GameServices · Clock&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=12;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="90" width="600" height="86" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b style=&quot;font-size:14px&quot;&gt;ui/ — 화면 출력과 키 입력, 사운드&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;Console · ITerminal · WindowsTerminal · AnsiTerminal · IInputSource · KeyboardInput · WindowsKeyboardInput · PosixKeyboardInput · Command · ISoundPlayer · BeepSoundPlayer · MuteSoundPlayer · View · BoardView · PhotoFrameView · HudView · NextBlockView · TextBoxView · ParticleView · PhotoPainter&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=12;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="256" width="560" height="122" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b style=&quot;font-size:14px&quot;&gt;stage/ — 스테이지, 사진 조각 진행, 앨범&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;StageConfig · StageCatalog · PhotoArt · PhotoProgress · Album&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=12;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="640" y="256" width="560" height="68" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b style=&quot;font-size:14px&quot;&gt;play/ — 한 판 진행과 이벤트&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;StageSession · SpeedController · PlayContext · EventBus · GameEvent · IGameEventListener · SoundCueListener&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=12;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="458" width="600" height="86" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b style=&quot;font-size:14px&quot;&gt;boss/ — 보스와 방해 기믹&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;Boss · BossGimmick · PeriodicGimmick · BlackoutGimmick · ShapeShiftGimmick · ForgetGimmick&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=12;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="624" width="380" height="86" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b style=&quot;font-size:14px&quot;&gt;medicine/ — 약&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;Pill · BluePill · RedPill · Inventory&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=12;fillColor=#e6d0de;strokeColor=#996185;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="410" y="624" width="380" height="68" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b style=&quot;font-size:14px&quot;&gt;block/ — 테트로미노와 블록 생성기&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;Tetromino · TetrominoType · BlockGenerator&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=12;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="820" y="624" width="380" height="68" as="geometry" /></mxCell><mxCell id="v10" value="&lt;b style=&quot;font-size:14px&quot;&gt;board/ — 보드&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;Board · Cell&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=12;fillColor=#fad9d5;strokeColor=#ae4132;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="410" y="790" width="380" height="68" as="geometry" /></mxCell><mxCell id="v11" value="&lt;b style=&quot;font-size:14px&quot;&gt;common/ — 공용 (좌표, 문자열, 예외)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face=&quot;Consolas&quot; style=&quot;font-size:11px&quot;&gt;Point · TextUtil · std::runtime_error · GameException · ConsoleException · ConfigException&lt;/font&gt;" style="rounded=1;html=1;whiteSpace=wrap;align=center;verticalAlign=top;spacing=12;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="938" width="1200" height="68" as="geometry" /></mxCell><mxCell id="v12" value="common/ 은 모든 폴더가 사용한다 (화살표 생략)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="908" width="600" height="24" as="geometry" /></mxCell><mxCell id="v13" value="View·Console 사용" style="html=1;endArrow=open;endSize=12;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v14" value="스테이지 데이터·앨범" style="html=1;endArrow=open;endSize=12;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v3" target="v5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v15" value="StageSession 소유" style="html=1;endArrow=open;endSize=12;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v3" target="v6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v16" value="const&amp; 로 읽기만" style="html=1;endArrow=open;endSize=12;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="v4" target="v6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v17" value="makeBoss()" style="html=1;endArrow=open;endSize=12;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="v5" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v18" value="" style="html=1;endArrow=open;endSize=12;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v19" value="" style="html=1;endArrow=open;endSize=12;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v6" target="v8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v20" value="" style="html=1;endArrow=open;endSize=12;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.85;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v6" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v21" value="PlayContext로 보드 조작" style="html=1;endArrow=open;endSize=12;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="v8" target="v10"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="② 상속 구조" id="p85087718"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v2" value="&lt;b&gt;② 상속 구조 (is-a)&lt;/b&gt; — 위가 부모, 아래가 자식. 자식 박스에는 &lt;u&gt;재정의(override)하거나 새로 추가한 멤버만&lt;/u&gt; 적었다." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=18;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="30" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;범례&lt;/b&gt;&lt;br&gt;──▷ 실선 빈 삼각형: 클래스 상속&lt;br&gt;┄┄▷ 점선 빈 삼각형: 인터페이스 구현&lt;br&gt;굵은 점선 테두리: 추상 클래스 / 인터페이스&lt;br&gt;&lt;i&gt;기울임&lt;/i&gt;: 순수 가상 함수 (= 0)&lt;br&gt;&lt;font color=&quot;#1a5fd0&quot;&gt;파란 글씨&lt;/font&gt;: 오버로딩&lt;br&gt;&lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; flow/ — 게임 루프와 장면&lt;br&gt;&lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; ui/ — 화면 출력과 키 입력, 사운드&lt;br&gt;&lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; stage/ — 스테이지, 사진 조각 진행, 앨범&lt;br&gt;&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; play/ — 한 판 진행과 이벤트&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;■&lt;/font&gt; boss/ — 보스와 방해 기믹&lt;br&gt;&lt;font color=&quot;#996185&quot;&gt;■&lt;/font&gt; medicine/ — 약&lt;br&gt;&lt;font color=&quot;#d79b00&quot;&gt;■&lt;/font&gt; block/ — 테트로미노와 블록 생성기&lt;br&gt;&lt;font color=&quot;#ae4132&quot;&gt;■&lt;/font&gt; board/ — 보드&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;■&lt;/font&gt; common/ — 공용 (좌표, 문자열, 예외)" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#ffffff;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1960" y="0" width="360" height="277" as="geometry" /></mxCell><mxCell id="v4" value="&lt;div style=&quot;text-align:center&quot;&gt;«abstract»&lt;br&gt;&lt;b&gt;&lt;i&gt;Scene&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;# m_services: GameServices&amp;amp;&lt;hr size=&quot;1&quot;&gt;+ onEnter(): virtual void&lt;br&gt;&lt;i&gt;+ handle(Command command): void = 0&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ update(int dtMs): void = 0&lt;/i&gt;&lt;br&gt;&lt;i&gt;+ render(Console&amp;amp; c) const: void = 0&lt;/i&gt;&lt;br&gt;# changeTo(std::unique_ptr&amp;lt;Scene&amp;gt; next): void  // SceneManager에 요청&lt;br&gt;# quit(): void" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;overflow=fill;fontSize=11;fontFamily=Consolas;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="684" y="74" width="444" height="165" as="geometry" /></mxCell><mxCell id="v5" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;TitleScene&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- m_decorations: std::array&amp;lt;Tetromino, 4&amp;gt;&lt;hr size=&quot;1&quot;&gt;+ onEnter(): void&lt;br&gt;+ handle(Command): void&lt;br&gt;+ update(int dtMs): void&lt;br&gt;+ render(Console&amp;amp;) const: void" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;overflow=fill;fontSize=11;fontFamily=Consolas;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="309" width="284" height="120" as="geometry" /></mxCell><mxCell id="v6" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;endArrow=block;endFill=0;endSize=14;strokeWidth=1.6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v5" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v7" value="&lt;div style=&quot;text-align:center&quot;&gt;«abstract»&lt;br&gt;&lt;b&gt;&lt;i&gt;NarrativeScene&lt;/i&gt;&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- m_lines: std::vector&amp;lt;NarrativeLine&amp;gt;&lt;br&gt;- m_index: size_t&lt;br&gt;# m_textBox: TextBoxView&lt;hr size=&quot;1&quot;&gt;+ handle(Command command): void&lt;br&gt;+ update(int dtMs): void&lt;br&gt;+ render(Console&amp;amp; c) const: void&lt;br&gt;&lt;i&gt;# renderBackground(Console&amp;amp; c) const: void = 0&lt;/i&gt;&lt;br&gt;&lt;i&gt;# onNarrationEnd(): void = 0&lt;/i&gt;&lt;br&gt;# onLineShown(size_t index): virtual void&lt;br&gt;# onUpdate(int dtMs): virtual void&lt;br&gt;# canAdvance() const: virtual bool" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;overflow=fill;fontSize=11;fontFamily=Consolas;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="472" y="309" width="316" height="225" as="geometry" /></mxCell><mxCell id="v8" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;PrologueScene&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;# renderBackground(Console&amp;amp; c) const: void&lt;br&gt;# onNarrationEnd(): void" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingRight=4;overflow=fill;fontSize=11;fontFamily=Consolas;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="328" y="604" width="290" height="67" as="geometry" /></mxCell><mxCell id="v9" value="" style="html=1;edgeStyle=orthogonalEdgeStyle;rounded=0;jettySize=auto;endArrow=block;endFill=0;endSize=14;strokeWidth=1.6;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v8" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v10" value="&lt;div style=&quot;text-align:center&quot;&gt;&lt;b&gt;EndingScene&lt;/b&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;&gt;- m_fragments: std::vector&amp;lt;Fragment&amp;gt;&lt;br&gt;- m_assembleMs: int&lt;hr size=&quot;1&quot;&gt;# renderBackground(Console&amp;amp; c) const: void&lt;br&gt;# onNarrationEnd(): void&lt;br&gt;# onLineShown(size_t index): void&lt;br&gt;# onUpdate(int dtMs): void&lt;br&gt;# canAdvance() const: bool" style="rounded=0;html=1;whiteSpace=wrap;verticalAlign=top;align=left;spacingLeft=6;spacingR